const NewsTickerItem = ({ item }: { item: NewsItem }) => {
  return (
    <div className="flex-none w-72 p-2">
      <div className="bg-surface rounded-lg overflow-hidden">
        <img
          src={item.image}
          alt={item.title}
          className="w-full h-32 object-cover"
        />
        <div className="p-4">
          <span className="text-xs text-primary uppercase">{item.type}</span>
          <h4 className="font-medium mt-1">{item.title}</h4>
          <p className="text-sm text-secondary mt-1">{item.date}</p>
        </div>
      </div>
    </div>
  );
};

export default function LandingPage() {
  const newsTickerRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const ticker = newsTickerRef.current;
    if (!ticker) return;

    const scrollNews = () => {
      if (ticker.scrollLeft + ticker.clientWidth >= ticker.scrollWidth) {
        ticker.scrollLeft = 0;
      } else {
        ticker.scrollLeft += 1;
      }
    };

    const interval = setInterval(scrollNews, 30);
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="space-y-12">
      {/* Hero Section */}
      <section>
        <HeroSlider />
      </section>

      <section>
      <h3 className="text-xl font-bold text-white mb-4">Our Hottest Music</h3>

{/* Artists Slider */}
<SliderWrapper title="Top Artists" itemCount={hotArtists.length}>
  {hotArtists.map(artist => (
    <ArtistCard key={artist.id} artist={artist} />
  ))}
</SliderWrapper>
      </section>

      {/* Hot Artists Section - Now using horizontal scrollable list */}
      <section>
        <ArtistsScrollList />
      </section>

     
      {/* Hot Trending  Section - Now using horizontal scrollable list */}
      <section>
        < TrendingScrollList />
        </section>


      {/* News Ticker */}
      <section className="relative">
        <h2 className="text-2xl font-bold mb-6">Latest News & Events</h2>
        <div
          ref={newsTickerRef}
          className="flex overflow-x-hidden scroll-smooth"
        >
          <div className="flex animate-scroll">
            {newsStream.map((item) => (
              <NewsTickerItem key={item.id} item={item} />
            ))}
          </div>
        </div>
      </section>
    </div>
  );
}