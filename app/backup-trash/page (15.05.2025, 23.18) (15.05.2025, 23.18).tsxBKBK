            <Play size={12} className="text-black" />
          </button>
        </div>
      </div>
      <div className="mt-1 text-center">
        <h3 className="font-semibold text-white text-xs truncate">{artist.name}</h3>
        <p className="text-xs text-gray-400">Artist • {artist.followers}</p>
      </div>
    </div>
